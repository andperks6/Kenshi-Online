{
  "game_version": "1.0.68",
  "sources": "KServerMod structs.h, KenshiLib GameWorld.h, Cheat Engine tables, lib/kenshilib (BFrizzleFoShizzle fork)",
  "_kenshilib_note": "Fields with 'kenshilib_proposed' come from lib/kenshilib/Include/kenshi/. Not yet promoted to runtime — must be verified against a running game (see docs/plans/2026-04-30-kenshilib-and-restructure.md Phase 1).",
  "character_offsets": {
    "faction":         { "offset": "0x10",  "type": "Faction*",        "source": "KServerMod", "verified": true,  "kenshilib_match": "RootObjectBase::owner @ 0x10" },
    "name":            { "offset": "0x18",  "type": "std::string",     "source": "KServerMod", "verified": true,  "kenshilib_match": "RootObjectBase::displayName @ 0x18" },
    "gameDataPtr":     { "offset": "0x40",  "type": "GameData*",       "source": "KServerMod", "verified": true,  "kenshilib_match": "RootObjectBase::data @ 0x40" },
    "position":        { "offset": "0x48",  "type": "Vec3",            "source": "KServerMod", "verified": true,  "kenshilib_match": "RootObjectBase::pos @ 0x48" },
    "rotation":        { "offset": "0x58",  "type": "Quat",            "source": "KServerMod", "verified": true,  "kenshilib_proposed": "0xB0", "_warning": "MISMATCH — KenshiLib places Ogre::Quaternion rot at 0xB0 (RootObject), while 0x58 is hand handle (RootObjectBase). Likely explains the 'looks like a pointer' rotation-write heuristic in sync_orchestrator.cpp. VERIFY in running game before changing." },
    "inventory":       { "offset": "0x2E8", "type": "Inventory*",      "source": "KServerMod", "verified": true,  "kenshilib_match": "Character::inventory @ 0x2E8" },
    "stats":           { "offset": "0x450", "type": "Stats (inline)",  "source": "KServerMod", "verified": true,  "kenshilib_match": "Character::stats @ 0x450" },
    "sceneNode":       { "offset": "-1",    "type": "SceneNode*",      "source": "unverified", "verified": false, "kenshilib_proposed": "investigate via animation/CharBody pointer" },
    "aiPackage":       { "offset": "-1",    "type": "AI*",             "source": "unverified", "verified": false, "kenshilib_proposed": "0x650", "kenshilib_field": "Character::ai" },
    "movement":        { "offset": "-1",    "type": "CharMovement*",   "source": "unverified", "verified": false, "kenshilib_proposed": "0x640", "kenshilib_field": "Character::movement" },
    "body":            { "offset": "-1",    "type": "CharBody*",       "source": "unverified", "verified": false, "kenshilib_proposed": "0x648", "kenshilib_field": "Character::body" },
    "animationClass":  { "offset": "-1",    "type": "AnimationClass*", "source": "unverified", "verified": false, "kenshilib_proposed": "0x448", "kenshilib_field": "Character::animation" },
    "platoon":         { "offset": "-1",    "type": "ActivePlatoon*",  "source": "unverified", "verified": false, "kenshilib_proposed": "0x658", "kenshilib_field": "Character::platoon" },
    "equipment":       { "offset": "-1",    "type": "ptr[14]",         "source": "runtime probed", "verified": false, "kenshilib_proposed": "use Character::inventory @ 0x2E8 + per-section accessors via Inventory.h" },
    "squad":           { "offset": "-1",    "type": "KSquad*",         "source": "runtime probed", "verified": false, "_alias_for": "platoon (see above)" },
    "currentTask":     { "offset": "-1",    "type": "uint32 enum",     "source": "unverified", "verified": false, "kenshilib_proposed": "investigate via Character::ai or movement" },
    "isAlive":         { "offset": "-1",    "type": "bool (use accessor)", "source": "use health chain", "verified": false, "kenshilib_proposed": "Character::isDead() RVA 0x620E30" },
    "isPlayerControlled": { "offset": "-1", "type": "bool (use accessor)", "source": "unverified", "verified": false, "kenshilib_proposed": "Character::isPlayerCharacter() RVA 0x790470" },
    "moveSpeed":       { "offset": "-1",    "type": "float (use accessor)", "source": "unverified", "verified": false, "kenshilib_proposed": "Character::getMovementSpeed() virtual, RVA 0x5C7C50" },
    "animState":       { "offset": "-1",    "type": "uint8",           "source": "unverified", "verified": false, "kenshilib_proposed": "via animationClass @ 0x448" },
    "isCarryingSomething": { "offset": "-1", "type": "bool",           "source": "unverified", "verified": false, "kenshilib_proposed": "0x348", "kenshilib_field": "Character::isCarryingSomething" },
    "carryingObject":  { "offset": "-1",    "type": "hand",            "source": "unverified", "verified": false, "kenshilib_proposed": "0x380", "kenshilib_field": "Character::carryingObject" }
  },
  "character_chains": {
    "health": {
      "chain": "char+0x2B8 -> +0x5F8 -> +0x40",
      "stride": 8,
      "type": "float health + float stun per body part",
      "source": "CE verified"
    },
    "money": {
      "chain": "char+0x298 -> +0x78 -> +0x88",
      "type": "int",
      "source": "CE verified",
      "kenshilib_proposed": "Character::getMoney() RVA 0x790400 — prefer accessor over chain"
    },
    "writable_position": {
      "chain": "char+animClassOffset -> +0xC0 -> +0x320 -> +0x20",
      "note": "animClassOffset discovered at runtime (0x60-0x200 probe)",
      "source": "KServerMod",
      "kenshilib_proposed": "animClassOffset = 0x448 (Character::animation), so chain = char+0x448 -> +0xC0 -> +0x320 -> +0x20"
    }
  },
  "world_offsets": {
    "gameSpeed":       { "offset": "0x700",  "type": "float",         "source": "KenshiLib",  "verified": true },
    "characterList":   { "offset": "0x0888", "type": "ptr array",     "source": "KenshiLib",  "verified": true },
    "zoneManager":     { "offset": "0x08B0", "type": "ZoneManager*",  "source": "KenshiLib",  "verified": true },
    "timeOfDay":       { "offset": "-1",     "type": "float",         "source": "on TimeManager +0x08, not GameWorld", "verified": false, "kenshilib_proposed": "see lib/kenshilib/Include/kenshi/util/TimeOfDay.h" },
    "weatherState":    { "offset": "-1",     "type": "int enum",      "source": "unverified", "verified": false },
    "buildingList":    { "offset": "-1",     "type": "ptr array",     "source": "unverified", "verified": false }
  },
  "time_manager_offsets": {
    "timeOfDay":       { "offset": "0x08",   "type": "float 0-1",     "source": "runtime hook capture", "verified": true },
    "gameSpeed":       { "offset": "0x10",   "type": "float",         "source": "runtime hook capture", "verified": true }
  },
  "building_offsets": {
    "_note": "All entries below are inferred from character struct similarity, not directly RE'd. Re-verify against lib/kenshilib/Include/kenshi/Building/Building.h before trusting.",
    "name":            { "offset": "0x10",   "type": "std::string",   "source": "same as character" },
    "position":        { "offset": "0x48",   "type": "Vec3",          "source": "same as character" },
    "rotation":        { "offset": "0x58",   "type": "Quat",          "source": "same as character", "_warning": "Same rotation discrepancy as character — likely should be 0xB0" },
    "ownerFaction":    { "offset": "0x80",   "type": "Faction*" },
    "health":          { "offset": "0xA0",   "type": "float" },
    "maxHealth":       { "offset": "0xA4",   "type": "float" },
    "isDestroyed":     { "offset": "0xA8",   "type": "bool" },
    "functionality":   { "offset": "0xC0",   "type": "BuildingFunctionality*" },
    "inventory":       { "offset": "0xE0",   "type": "Inventory*" },
    "buildProgress":   { "offset": "0x110",  "type": "float 0-1" },
    "isConstructed":   { "offset": "0x114",  "type": "bool" }
  },
  "inventory_offsets": {
    "_note": "Re-verify against lib/kenshilib/Include/kenshi/Inventory.h — all entries below are guesses.",
    "items":           { "offset": "0x10",   "type": "Item* array" },
    "itemCount":       { "offset": "0x18",   "type": "int" },
    "width":           { "offset": "0x20",   "type": "int" },
    "height":          { "offset": "0x24",   "type": "int" }
  },
  "faction_offsets": {
    "_note": "Re-verify against lib/kenshilib/Include/kenshi/Faction.h — only factionId has direct evidence.",
    "name":            { "offset": "0x10",   "type": "std::string" },
    "factionId":       { "offset": "0x08",   "type": "uint32",        "source": "faction_hooks.cpp reads at +0x08" },
    "members":         { "offset": "0x30",   "type": "ptr array" },
    "relations":       { "offset": "0x50",   "type": "map ptr" },
    "isPlayerFaction": { "offset": "0x90",   "type": "bool" },
    "money":           { "offset": "0xA0",   "type": "int" }
  },
  "stats_offsets": {
    "meleeAttack":     "0x00", "meleeDefence": "0x04", "dodge": "0x08",
    "martialArts":     "0x0C", "strength":     "0x10", "toughness": "0x14",
    "dexterity":       "0x18", "athletics":    "0x1C", "crossbows": "0x20",
    "turrets":         "0x24", "precision":    "0x28", "stealth":   "0x30",
    "assassination":   "0x34", "lockpicking":  "0x38", "thievery":  "0x3C",
    "science":         "0x40", "engineering":  "0x44", "medic":     "0x48",
    "farming":         "0x50", "cooking":      "0x54", "weaponsmith": "0x58",
    "armoursmith":     "0x5C", "labouring":    "0x60"
  },
  "singletons": {
    "PlayerBase":         { "rva": "0x01AC8A90", "source": "pattern scanner" },
    "GameWorldSingleton": { "rva": "0x02133040", "source": "pattern scanner", "kenshilib_match": "extern GameWorld* ou; (Globals.h)" }
  },
  "string_layout": {
    "type": "MSVC x64 std::string",
    "sso_threshold": 15,
    "buf_offset":    "0x00 (16 bytes inline)",
    "size_offset":   "0x10 (uint64_t)",
    "capacity_offset": "0x18 (uint64_t)",
    "heap_ptr_at":   "0x00 (first 8 bytes when capacity > 15)"
  }
}
